
@IsTest
static void successfulFraudMailboxEmail() {
    Case fraudCase = makeCase();
    EmailTemplate template = makeTemplate();

    addFile(
        fraudCase.Id,
        'fraud-evidence',
        Blob.valueOf('Fraud evidence attachment')
    );

    List<OrgWideEmailAddress> addresses = [
        SELECT Id
        FROM OrgWideEmailAddress
        WHERE IsAllowAllProfiles = true
        LIMIT 1
    ];

    Assert.isFalse(
        addresses.isEmpty(),
        'A verified Org-Wide Email Address is required.'
    );

    SendFraudMailboxEmail.EmailRequest request =
        requestFor(
            fraudCase.Id,
            template.Id,
            addresses[0].Id,
            RECIPIENT
        );

    Test.startTest();

    List<SendFraudMailboxEmail.EmailResponse> results =
        SendFraudMailboxEmail.sendFraudMailboxEmails(
            new List<SendFraudMailboxEmail.EmailRequest>{
                request
            }
        );

    Test.stopTest();

    Assert.areEqual(
        1,
        results.size(),
        'Expected one response.'
    );

    Assert.isTrue(
        results[0].success,
        'Expected successful email send. Actual: ' +
        results[0].statusMessage
    );

    Assert.areEqual(
        'Fraud Mailbox email sent successfully.',
        results[0].statusMessage
    );
}
}
